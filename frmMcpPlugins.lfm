object McpPluginsForm: TMcpPluginsForm
  Left = 280
  Height = 520
  Top = 160
  Width = 760
  BorderStyle = bsDialog
  Caption = 'MCP Connections'
  ClientHeight = 520
  ClientWidth = 760
  Position = poScreenCenter
  LCLVersion = '4.8.0.0'
  OnShow = FormShow
  object lblTitle: TLabel
    Left = 24
    Height = 24
    Top = 16
    Width = 144
    Caption = 'MCP plugin connections'
    Font.Height = -16
    Font.Style = [fsBold]
    ParentFont = False
  end
  object lblHint: TLabel
    Left = 24
    Height = 40
    Top = 44
    Width = 712
    Anchors = [akTop, akLeft, akRight]
    AutoSize = False
    Caption = 'Add HTTP (URL + Bearer) or local stdio MCP servers. Use the connection name as @alias in chat to activate tools for the session.'
    WordWrap = True
  end
  object lvConnections: TListView
    Left = 24
    Height = 320
    Top = 96
    Width = 712
    Anchors = [akTop, akLeft, akRight, akBottom]
    Columns = <>
    ReadOnly = True
    RowSelect = True
    TabOrder = 0
    ViewStyle = vsReport
    OnResize = lvConnectionsResize
  end
  object pnlActions: TPanel
    Left = 24
    Height = 40
    Top = 424
    Width = 712
    Anchors = [akLeft, akRight, akBottom]
    BevelOuter = bvNone
    ClientHeight = 40
    ClientWidth = 712
    TabOrder = 1
    object btnAdd: TLcaPaintButton
      Left = 0
      Height = 32
      Top = 4
      Width = 88
      Caption = 'Add'
      TabOrder = 0
      OnClick = btnAddClick
      ButtonRole = tbrPrimary
    end
    object btnEdit: TLcaPaintButton
      Left = 96
      Height = 32
      Top = 4
      Width = 88
      Caption = 'Edit'
      TabOrder = 1
      OnClick = btnEditClick
      ButtonRole = tbrGhost
    end
    object btnRemove: TLcaPaintButton
      Left = 192
      Height = 32
      Top = 4
      Width = 88
      Caption = 'Remove'
      TabOrder = 2
      OnClick = btnRemoveClick
      ButtonRole = tbrDestructive
    end
    object btnTest: TLcaPaintButton
      Left = 296
      Height = 32
      Top = 4
      Width = 120
      Caption = 'Test connection'
      TabOrder = 3
      OnClick = btnTestClick
      ButtonRole = tbrPrimary
    end
  end
  object pnlBottom: TPanel
    Left = 0
    Height = 56
    Top = 464
    Width = 760
    Align = alBottom
    BevelOuter = bvNone
    ClientHeight = 56
    ClientWidth = 760
    TabOrder = 2
    object btnClose: TLcaPaintButton
      Left = 648
      Height = 32
      Top = 12
      Width = 88
      Anchors = [akTop, akRight]
      Caption = 'Close'
      TabOrder = 0
      OnClick = btnCloseClick
    end
  end
end
